{
  "name": "pushpal",
  "displayName": "PushPal",
  "description": "%ext.description%",
  "version": "1.0.0",
  "publisher": "pushpal",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F2A2E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pug-03/PushPug.git"
  },
  "bugs": {
    "url": "https://github.com/Pug-03/PushPug/issues"
  },
  "homepage": "https://github.com/Pug-03/PushPug#readme",
  "keywords": [
    "git",
    "pull",
    "merge conflict",
    "team",
    "notification",
    "github",
    "collaboration",
    "thai"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "extensionDependencies": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%ext.untrusted%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "pushpal.pull",
        "title": "%cmd.pull%",
        "category": "PushPal",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pushpal.checkNow",
        "title": "%cmd.checkNow%",
        "category": "PushPal",
        "icon": "$(refresh)"
      },
      {
        "command": "pushpal.setup",
        "title": "%cmd.setup%",
        "category": "PushPal",
        "icon": "$(rocket)"
      },
      {
        "command": "pushpal.showTeam",
        "title": "%cmd.showTeam%",
        "category": "PushPal"
      },
      {
        "command": "pushpal.showConflicts",
        "title": "%cmd.showConflicts%",
        "category": "PushPal"
      },
      {
        "command": "pushpal.finishMerge",
        "title": "%cmd.finishMerge%",
        "category": "PushPal"
      },
      {
        "command": "pushpal.testNotification",
        "title": "%cmd.testNotification%",
        "category": "PushPal"
      },
      {
        "command": "pushpal.openSettings",
        "title": "%cmd.openSettings%",
        "category": "PushPal",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pushpal.switchMode",
        "title": "%cmd.switchMode%",
        "category": "PushPal",
        "icon": "$(dashboard)"
      },
      {
        "command": "pushpal.push",
        "title": "%cmd.push%",
        "category": "PushPal",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "pushpal.undoMerge",
        "title": "%cmd.undoMerge%",
        "category": "PushPal",
        "icon": "$(discard)"
      },
      {
        "command": "pushpal.snooze",
        "title": "%cmd.snooze%",
        "category": "PushPal",
        "icon": "$(bell-slash)"
      },
      {
        "command": "pushpal.unsnooze",
        "title": "%cmd.unsnooze%",
        "category": "PushPal",
        "icon": "$(bell)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pushpal.checkNow",
          "when": "view == pushpal.team",
          "group": "navigation@1"
        },
        {
          "command": "pushpal.setup",
          "when": "view == pushpal.team",
          "group": "navigation@2"
        },
        {
          "command": "pushpal.openSettings",
          "when": "view == pushpal.team",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "pushpal.finishMerge",
          "when": "pushpal.hasConflict"
        }
      ],
      "scm/title": [
        {
          "command": "pushpal.push",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pushpal",
          "title": "PushPal",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "pushpal": [
        {
          "type": "webview",
          "id": "pushpal.team",
          "name": "%view.team%",
          "icon": "media/activity.svg",
          "contextualTitle": "PushPal"
        }
      ]
    },
    "configuration": {
      "title": "PushPal",
      "properties": {
        "pushpal.language": {
          "type": "string",
          "enum": [
            "auto",
            "th",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.language.auto%",
            "ภาษาไทย",
            "English"
          ],
          "default": "auto",
          "order": 1,
          "description": "%cfg.language%"
        },
        "pushpal.theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "%cfg.theme.system%",
            "%cfg.theme.light%",
            "%cfg.theme.dark%"
          ],
          "default": "system",
          "order": 2,
          "description": "%cfg.theme%"
        },
        "pushpal.mode": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "batterySaver",
            "custom"
          ],
          "enumDescriptions": [
            "%cfg.mode.fast%",
            "%cfg.mode.balanced%",
            "%cfg.mode.batterySaver%",
            "%cfg.mode.custom%"
          ],
          "default": "balanced",
          "markdownDescription": "%cfg.mode%",
          "order": 3
        },
        "pushpal.checkIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "order": 4,
          "markdownDescription": "%cfg.interval%"
        },
        "pushpal.background.intervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 60,
          "maximum": 3600,
          "markdownDescription": "%cfg.background.interval%",
          "order": 5
        },
        "pushpal.battery.idle.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.battery.idle.enabled%",
          "order": 6
        },
        "pushpal.battery.idle.minutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 240,
          "markdownDescription": "%cfg.battery.idle.minutes%",
          "order": 7
        },
        "pushpal.battery.idle.intervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "%cfg.battery.idle.interval%",
          "order": 8
        },
        "pushpal.battery.lowBattery.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.battery.low.enabled%",
          "order": 9
        },
        "pushpal.battery.lowBattery.percent": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 95,
          "markdownDescription": "%cfg.battery.low.percent%",
          "order": 10
        },
        "pushpal.battery.lowBattery.intervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "%cfg.battery.low.interval%",
          "order": 11
        },
        "pushpal.battery.lowPowerMode.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.battery.lpm.enabled%",
          "order": 12
        },
        "pushpal.battery.lowPowerMode.intervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "%cfg.battery.lpm.interval%",
          "order": 13
        },
        "pushpal.battery.pluggedInUsesNormal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.battery.plugged%",
          "order": 14
        },
        "pushpal.activeHours.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.hours.enabled%",
          "order": 15
        },
        "pushpal.activeHours.start": {
          "type": "string",
          "default": "08:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "HH:MM",
          "markdownDescription": "%cfg.hours.start%",
          "order": 16
        },
        "pushpal.activeHours.end": {
          "type": "string",
          "default": "23:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "HH:MM",
          "markdownDescription": "%cfg.hours.end%",
          "order": 17
        },
        "pushpal.notify.inVSCode": {
          "type": "boolean",
          "default": true,
          "order": 18,
          "description": "%cfg.notify.inVSCode%"
        },
        "pushpal.notify.desktop": {
          "type": "boolean",
          "default": true,
          "order": 19,
          "description": "%cfg.notify.desktop%"
        },
        "pushpal.notify.background": {
          "type": "boolean",
          "default": false,
          "order": 20,
          "markdownDescription": "%cfg.notify.background%"
        },
        "pushpal.notify.sameFileWarning": {
          "type": "boolean",
          "default": true,
          "order": 21,
          "description": "%cfg.notify.sameFile%"
        },
        "pushpal.actions.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.actions.enabled%",
          "order": 22
        },
        "pushpal.actions.intervalSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 10,
          "maximum": 120,
          "markdownDescription": "%cfg.actions.interval%",
          "order": 23
        },
        "pushpal.avatars": {
          "type": "boolean",
          "default": true,
          "order": 24,
          "markdownDescription": "%cfg.avatars%"
        },
        "pushpal.actions.notifyOnPass": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.actions.onPass%",
          "order": 25
        },
        "pushpal.actions.notifyFor": {
          "type": "string",
          "enum": [
            "all",
            "mine",
            "team"
          ],
          "enumDescriptions": [
            "%cfg.actions.for.all%",
            "%cfg.actions.for.mine%",
            "%cfg.actions.for.team%"
          ],
          "default": "all",
          "markdownDescription": "%cfg.actions.for%",
          "order": 26
        },
        "pushpal.quiet.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.quiet.enabled%",
          "order": 27
        },
        "pushpal.quiet.start": {
          "type": "string",
          "default": "22:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "HH:MM",
          "markdownDescription": "%cfg.quiet.start%",
          "order": 28
        },
        "pushpal.quiet.end": {
          "type": "string",
          "default": "08:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "patternErrorMessage": "HH:MM",
          "markdownDescription": "%cfg.quiet.end%",
          "order": 29
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/build.mjs --tests",
    "test": "node --test --test-concurrency=1 \"out-test/*.test.js\"",
    "icon": "node scripts/render-icon.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "package": "vsce package --no-dependencies",
    "smoke": "npm run build && node scripts/smoke/run.mjs",
    "demo-gif": "node scripts/demo-gif.mjs",
    "release": "npm version patch && git push --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "gsap": "3.15.0",
    "playwright-core": "1.64.0",
    "typescript": "~5.8.3"
  }
}
